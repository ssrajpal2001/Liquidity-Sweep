# =============================================================================
# Copy this file to .env and fill in real values.
# .env is gitignored — NEVER commit real secrets.
# =============================================================================

# From your Fyers API app (https://myapi.fyers.in/dashboard)
# client_id is the FULL app id including the "-100" suffix, e.g. "XC1234-100"
FYERS_CLIENT_ID=your_client_id_here
FYERS_SECRET_KEY=your_secret_key_here

# Must exactly match the redirect URI registered on the Fyers app
FYERS_REDIRECT_URI=https://your-redirect-uri.example.com/callback

# "true" -> paper/sandbox-style dry run (see README "Going live" — Fyers
# itself has no separate sandbox environment like Upstox; this flag instead
# gates whether main.py is allowed to place real orders at all).
PAPER_MODE=true

# Optional: paste a freshly generated auth code here to skip the
# interactive prompt when running `python -m auth.auth login`. Leave blank
# to be prompted instead (recommended for daily manual use).
FYERS_AUTH_CODE=

# Where the daily token record is persisted. Relative paths resolve against
# the project root. This file is gitignored.
TOKEN_STORE_PATH=secrets/token_store.json

# =============================================================================
# Web UI (run_webapp.py) — login, broker credential management, connect toggle.
# Broker credentials themselves (client_id, secret_key, etc.) are entered
# through the web form and stored ENCRYPTED in secrets/credentials.db —
# they do NOT go in this file. Only the web UI's own secrets go here.
# =============================================================================

# Flask session signing key. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
WEBAPP_SECRET_KEY=

# Encryption key for the credential vault (secrets/credentials.db).
# Generate with:
#   python -c "from webapp.credential_vault import generate_encryption_key; print(generate_encryption_key())"
# BACK THIS UP SEPARATELY — losing it makes every stored broker credential
# permanently unreadable.
WEBAPP_ENCRYPTION_KEY=

# Login for the web UI itself (one shared admin login for now).
WEBAPP_ADMIN_USER=admin
# Generate the hash with:
#   python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your-password-here'))"
WEBAPP_ADMIN_PASSWORD_HASH=

# Optional — defaults shown
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=5000

# =============================================================================
# Copy this file to .env and fill in real values.
# .env is gitignored — NEVER commit real secrets.
# =============================================================================

# From your Fyers API app (https://myapi.fyers.in/dashboard)
# client_id is the FULL app id including the "-100" suffix, e.g. "XC1234-100"
FYERS_CLIENT_ID=your_client_id_here
FYERS_SECRET_KEY=your_secret_key_here

# Must exactly match the redirect URI registered on the Fyers app
FYERS_REDIRECT_URI=https://your-redirect-uri.example.com/callback

# "true" -> paper/sandbox-style dry run (see README "Going live" — Fyers
# itself has no separate sandbox environment like Upstox; this flag instead
# gates whether main.py is allowed to place real orders at all).
PAPER_MODE=true

# Optional: paste a freshly generated auth code here to skip the
# interactive prompt when running `python -m auth.auth login`. Leave blank
# to be prompted instead (recommended for daily manual use).
FYERS_AUTH_CODE=

# Where the daily token record is persisted. Relative paths resolve against
# the project root. This file is gitignored.
TOKEN_STORE_PATH=secrets/token_store.json

# =============================================================================
# Web UI (run_webapp.py) — everything (accounts, broker credentials,
# connection state) is stored in secrets/credentials.db, created
# automatically. No web-UI secrets need to go in this file — the two
# infra secrets it needs auto-generate into secrets/webapp_secret.key and
# secrets/webapp_encryption.key on first run.
# =============================================================================

# Optional — defaults shown
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=5000

# =============================================================================
# Copy this file to .env and fill in real values.
# .env is gitignored — NEVER commit real secrets.
# =============================================================================

# From your Upstox Developer App (https://developer.upstox.com)
UPSTOX_API_KEY=your_api_key_here
UPSTOX_API_SECRET=your_api_secret_here

# Must exactly match the redirect URI registered on the Upstox app
UPSTOX_REDIRECT_URI=https://your-redirect-uri.example.com/callback

# "true" -> use Upstox sandbox environment, "false" -> live trading
UPSTOX_SANDBOX=true

# Optional: paste a freshly generated authorization code here to skip the
# interactive prompt when running `python -m auth.auth login`. Leave blank
# to be prompted instead (recommended for daily manual use).
UPSTOX_AUTH_CODE=

# Where the daily token record is persisted. Relative paths resolve against
# the project root. This file is gitignored.
TOKEN_STORE_PATH=secrets/token_store.json
